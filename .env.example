# Supabase - Get from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Sheets Leads - same spreadsheet for all leads
# Paste the Apps Script Web App URL (see docs/GOOGLE_SHEETS_LEADS_SETUP.md)
GOOGLE_SHEETS_WEB_APP_URL=""
GOOGLE_SHEETS_SECURITY_KEY=""
# Separate tab in that same spreadsheet for Power Backup Calculator leads
GOOGLE_SHEETS_BACKUP_CALC_TAB="Power Backup Calculator"

# Contact & Site
CONTACT_EMAIL="your@email.com"
NEXT_PUBLIC_BUSINESS_PHONE="+91 9391026003"
NEXT_PUBLIC_WHATSAPP_NUMBER="919391026003"
NEXT_PUBLIC_SITE_URL="https://universalbatteries.co.in"

# ---------------------------------------------------------------------------
# Twilio Verify (Power Backup Calculator OTP)
# Paste from Twilio Console → Account → API keys / Auth token
# and Console → Verify → Services → Service SID
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# Random 32+ char string used to sign the "number verified" cookie (required in production)
# Generate with: openssl rand -hex 32
BACKUP_CALC_SESSION_SECRET=""
